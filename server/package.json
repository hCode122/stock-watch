{
  "name": "stock-tracker-backend",
  "version": "1.0.0",
  "description": "Backend for stock tracking application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:debug": "nodemon --inspect src/index.ts",
    "build": "tsc --skipLibCheck",
    "start": "npm run migrate && node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "db:init": "ts-node src/scripts/initDatabase.ts",
    "db:reset": "ts-node src/scripts/resetDatabase.ts",
    "db:test": "ts-node src/scripts/testConnection.ts",
    "job": "ts-node src/jobs/scheduler.ts",
    "test": "echo \"No tests yet\" && exit 0",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "echo \"No linter configured\"",
    "migrate": "node dist/scripts/runMigrations.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
